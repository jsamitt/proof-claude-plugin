{
  "description": "Proof harness — guardrails that cost nothing to run: destructive-command and protected-path denial, an opt-in verify-before-finishing gate, and transcript archiving before compaction.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre-bash-guard.sh\"", "timeout": 10 }]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/pre-write-guard.sh\"", "timeout": 10 }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/stop-verify.sh\"", "timeout": 600 }]
      }
    ],
    "PreCompact": [
      {
        "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/precompact-archive.sh\"", "timeout": 15 }]
      }
    ]
  }
}
