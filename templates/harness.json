  "labels": {
    "ready": "ready-to-dev",
    "in_progress": "in-progress",
    "discovered": "discovered",
    "blocked": "blocked",
    "p1": "P1",
    "p2": "P2",
    "p3": "P3",
    "investigate": "needs-investigation"
  },
  "voice": {
    "audience": null
  },
  "review": {
    "lenses": [
      "correctness",
      "breaker",
      "risk"
    ],
    "risk_focus": []
  },
  "design": {
    "tokens": null,
    "reference": null,
    "platform": null,
    "rules": []
  },
  "ship": {
    "preflight": [],
    "steps": [],
    "version_files": [],
    "changelog": null,
    "store_notes": false
  },
  "learnings": {
    "file": "DECISIONS.md"
  },
  "protected_paths": [
    "**/.env*",
    "**/*.pem",
    "**/*.key"
  ],
  "branch": {
    "base": "main",
    "prefix": "feat/"
  }
}
