{
  "$schema": "proof/harness-config@1",
  "project": {
    "name": "<Project name>",
    "summary": "<One sentence: what this is and who it is for>",
    "docs": [
      "CLAUDE.md"
    ]
  },
  "goals": [],
  "commands": {
    "test": null,
    "typecheck": null,
    "lint": null,
    "build": null,
    "run": null
  },
